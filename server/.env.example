# Port the HTTP + Socket.IO server listens on (Render injects this automatically)
PORT=3001
# Comma-separated list of allowed browser origins. Only needed if the client is hosted
# separately (e.g. your Vite dev server, or a client deployed on its own). The server
# always allows its own address too, so a single-service deploy needs this blank.
CLIENT_ORIGIN=http://localhost:5173
# Optional. Without it, player stats are kept in memory and reset on restart.
MONGODB_URI=
# Set to true behind a reverse proxy (Render) so rate limits see the real client IP
TRUST_PROXY=false
# debug | info | warn | error
LOG_LEVEL=info
